# TDLib shared library path (optional — auto-detected)
# TG_TDLIB_PATH=/usr/lib/libtdjson.so

# Proxy for TDLib (optional — needed in regions where Telegram is blocked)
# TG_PROXY=socks5://127.0.0.1:7890

# Data directory (optional — defaults to plugin root)
# TG_DATA_DIR=./tdlib_data

# Telegram API credentials (optional — built-in defaults used if unset)
# TG_API_ID=1025907
# TG_API_HASH=452b0359b988148995f22ff0f4229750

# Server ports (optional — defaults: HTTP 8080, WS 8081)
# TG_PORT=8080
# TG_WS_PORT=8081
